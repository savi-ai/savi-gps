# Savi GPS Backend — environment template (copy to .env and fill in values)
# Apache-2.0 OSS Alpha — never commit a filled-in .env

APP_NAME=Savi GPS
ENVIRONMENT=development
DEBUG=true

# Primary app database (SQLite default; Postgres for production)
DATABASE_URL=sqlite:///./gps.db

# Intelligence vector store (optional — start with: docker compose up -d postgres)
INTELLIGENCE_DATABASE_URL=postgresql://savi:savi@localhost:5432/savi_gps_intelligence

# Feature flags (tenant defaults inherit these when no onboarding path is set)
INTELLIGENCE_ENABLED=true
FLEET_ENABLED=false
PORTFOLIO_ENABLED=true
MODERNIZE_ENABLED=true

# Set false once Alembic-only schema path is verified on your dev DB
USE_LEGACY_SQLITE_MIGRATIONS=true

# Neo4j — symbol / call graph (optional — docker compose up -d neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-production
NEO4J_DATABASE=neo4j

# LLM
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Embeddings
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
VOYAGE_API_KEY=

# Auth — rotate SECRET_KEY before any production deploy
SECRET_KEY=change-me-in-production-min-32-characters
API_KEY=
ADMIN_TOKEN=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated; required explicit list in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SOP paths (defaults work for local dev)
SOP_DIRECTORY=./sops
SOP_SCHEMA_PATH=./schemas/sop.schema.json

# Storage — tenant-scoped analysis artifacts live under STORAGE_BASE_PATH/tenants/{tenant_id}/repos/{repo_id}/analysis/
# Leave empty to use backend/storage (default for local dev)
STORAGE_BASE_PATH=
STORAGE_TYPE=local

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# External integrations
JIRA_ENABLED=false
CONFLUENCE_ENABLED=false
GITHUB_ENABLED=false
HARNESS_ENABLED=false

# GitHub PAT — scopes: repo, read:org (Intelligence import/indexing)
GITHUB_TOKEN=
